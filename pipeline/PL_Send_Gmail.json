{
	"name": "PL_Send_Gmail",
	"properties": {
		"activities": [
			{
				"name": "Read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.audit_log WHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSql_Metadata_tables",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare Gmail body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and transformation process for Health Care Platform has been completed. Please find status below:"
				}
			},
			{
				"name": "Prepare Gmail body footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any queries or support, please contact HCP Support Team."
				}
			},
			{
				"name": "Prepare Email Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Health Care Platform | @{pipeline().globalParameters.ENV} | Main Driver Pipeline Run | @{if(greater(activity('Check overall failed count').output.firstRow.count, 0), 'Failed', 'Success')}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT count(*) AS count FROM ctrl.audit_log\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\nAND status <> 'SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSql_Metadata_tables",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Logic Apps Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Gmail body footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Gmail body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read all tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"subject\":\"@{variables('email_subject')}\",\n\"email_recipients\":\"@{pipeline().globalParameters.email_recipients}\",\n\"body_header\":\"@{variables('body_header')}\",\n\"body_footer\":\"@{variables('body_footer')}\",\n\"status_table\": @{activity('Read all tables status').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send Gmail",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare Logic Apps Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_app_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a0af374b-15d3-44c2-995e-3404a5e662f3"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}